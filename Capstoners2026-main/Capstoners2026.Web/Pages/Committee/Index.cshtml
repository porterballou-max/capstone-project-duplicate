@page
@model Capstoners2026.Web.Pages.Committee.CommitteeMembersManagerModel
@{
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="d-flex flex-column">

	<table class="table span12 caption-top">
		<caption class="h2">Members</caption>
		<thead>
			<tr>
				<th style="width:70%">Name</th>
				<th style="width:30%">Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model.CommitteeMembers)
			{
				<tr>
					<td>@user.UserName</td>
					<td class="d-flex flex-row gap-3">
						<form method="post" asp-page-handler="RemoveCommitteeMember">
							<input type="hidden" name="id" value="@user.Id" />
							<button type="submit" class="btn btn-danger btn-sm"
									onclick="return true;">
								Remove
							</button>
						</form>

						@if (await Model.UserManager.IsInRoleAsync(user, "CommitteeChair"))
						{
							<form method="post" asp-page-handler="RemoveChairRoleFromUser">
								<input type="hidden" name="id" value="@user.Id" />
								<button type="submit" class="btn btn-outline-danger btn-sm" onclick="return true;">Remove Chair Role</button>
							</form>
						}
						else
						{
							<form method="post" asp-page-handler="AddChairRoleToUser">
								<input type="hidden" name="id" value="@user.Id" />
								<button type="submit" class="btn btn-outline-primary btn-sm" onclick="return true;">Add Chair Role</button>
							</form>
						}

					</td>
					

				</tr>
			}
		</tbody>
	</table>

	<table class="table span12 caption-top">
		<caption class="h2">Non Members</caption>
		<thead>
			<tr>
				<th style="width:70%">Name</th>
				<th style="width:30%">Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model.NonCommitteeMembers)
			{
				<tr>
					<td>@user.UserName</td>
					<td class="d-flex flex-row gap-3">
						<form class="list-group-item" method="post" asp-page-handler="AddCommitteeMember">
							<input type="hidden" name="id" value="@user.Id" />
							<button type="submit" class="btn btn-success btn-sm"
									onclick="return true;">
								Add
							</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>

</div>