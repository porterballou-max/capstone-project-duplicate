@page "{id:int}"
@model Capstoners2026.Web.Pages.Grants.EditModel
@{
    ViewData["Title"] = "Edit Grant";
}

<h2>Edit Grant</h2>

<form method="post" enctype="multipart/form-data" class="mt-3">
    <partial name="_GrantForm" model="Model.GrantViewModel" />

    <button type="submit" asp-page-handler="Save" class="btn btn-success">Save</button>
    <button type="submit" asp-page-handler="Submit" class="btn btn-primary ms-2">Submit</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <script>
        // Set initial state based on existing value for departments
        if (document.getElementById('Grant_DepartmentsInvolved').value > 1) {
            document.getElementById('multipleDepts-yes').checked = true;
            document.getElementById('deptsInvolvedDiv').style.display = 'block';
        } else {
            document.getElementById('multipleDepts-no').checked = true;
        }

        // Set initial state based on existing value for human/animal subjects
        if (document.getElementById('Grant_UsesHumanOrAnimalSubjects').value === 'True') {
            document.getElementById('humanAnimalSubjects-yes').checked = true;
            document.getElementById('irbFileDiv').style.display = 'block';
        } else {
            document.getElementById('humanAnimalSubjects-no').checked = true;
        }

        // Set initial state for matching funds
        if (document.getElementById('Grant_HasMatchingFunds').checked) {
            document.getElementById('matchingFundsDiv').style.display = 'block';
        }
    </script>
}