@page
@model Capstoners2026.Web.Pages.Grants.IndexModel
@{
    ViewData["Title"] = "Grants";
}

<div class="card p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="mb-0">Grants</h2>

        <a class="btn btn-primary"
           asp-page="Create">

            + Add Grant

        </a>

    </div>

    <table class="table table-hover align-middle">

        <thead>

            <tr>
                <th>Title</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var grant in Model.Grants)
            {
                <tr>

                    <td>@grant.Title</td>

                    <td>@(grant.Department?.Name ?? "—")</td>

                    <td>

                        <a class="btn btn-outline-secondary btn-sm"
                           asp-page="Edit"
                           asp-route-id="@grant.Id">

                            Edit

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>