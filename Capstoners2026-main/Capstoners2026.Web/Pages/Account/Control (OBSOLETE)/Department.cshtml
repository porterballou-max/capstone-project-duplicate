@page
@model Capstoners2026.Web.Pages.Account.Control.DepartmentModel
@{
    ViewData["Title"] = "Change Department";
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="app-container">
    <div class="main-content">
        <div class="profile-container card p-4 shadow-sm mx-auto" style="max-width: 400px;">

            <h3 class="text-center mb-4">@ViewData["Title"]</h3>

            <form method="post">

                <div class="mb-3">
                    <label asp-for="DepartmentId" class="form-label">Department</label>
                    <select id="DepartmentsDropdown" asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 mb-3">
                    Submit
                </button>

                <a class="btn btn-outline-dark w-100 mb-3" onclick="window.history.go(-1); return false;">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>