@page
@model Capstoners2026.Web.Pages.Account.Control.EmailModel
@{
    ViewData["Title"] = "Change Email Address";
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="app-container">
    <div class="main-content">
        <div class="profile-container card p-4 shadow-sm mx-auto" style="max-width: 400px;">

            <h3 class="text-center mb-4">@ViewData["Title"]</h3>

            <form method="post">

                <div class="mb-3">
                    <label class="form-label" asp-for="NewEmail"></label>
                    <input class="form-control" asp-for="NewEmail" type="email" />
                    <span asp-validation-for="NewEmail" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 mb-3">
                    Submit
                </button>

                <a class="btn btn-outline-dark w-100 mb-3" onclick="window.history.go(-1); return false;">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>